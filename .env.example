# Cinematch — example environment file
# Copy to `.env` and fill in real values. Never commit `.env`.

# ===== Flask =====
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# ===== Database =====
DATABASE_URL=postgresql://user:password@localhost:5432/cinematch
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Admin =====
ADMIN_SECRET_PATH=change-me
ALLOW_REGISTRATION=False

# ===== CORS =====
CORS_ORIGINS=http://localhost:5000

# ===== Encryption =====
ENCRYPTION_KEY=change-me

# ===== Email (optional, for transactional templates) =====
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== OAuth (optional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== AI providers (optional — features disabled in this public build) =====
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ===== Movie data APIs (optional) =====
TMDB_API_KEY=
OMDB_API_KEY=
YOUTUBE_API_KEY=

# ===== S3-compatible storage (optional) =====
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=
ENABLE_S3_BACKUP=False

# ===== Stripe (optional — payment module not in this public build) =====
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# ===== Logging =====
LOG_LEVEL=INFO
LOG_TO_STDOUT=False
